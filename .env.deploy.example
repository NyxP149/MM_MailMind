# Copiez ce fichier vers .env.deploy avec deploy/initialize-deployment.ps1.
MAILMIND_PUBLIC_URL=https://mailmind.example.com
MAILMIND_LOCAL_PORT=8080

GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre-secret-client
COOKIE_SECRET=genere-automatiquement
DATA_ENCRYPTION_KEY=generee-automatiquement

# Ollama reste sur la machine hôte. Pour désactiver l'IA, utilisez AI_PROVIDER=openai et laissez OPENAI_API_KEY vide.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

TOKEN_STORE_PATH=/data/oauth.enc
AGENT_STATE_PATH=/data/agent-state.enc
