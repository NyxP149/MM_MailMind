# Copiez ce fichier vers .env après avoir créé les identifiants OAuth dans Google Cloud.
GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre-secret-client
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
PORT=3000
# Une chaîne aléatoire longue (minimum 32 caractères) utilisée pour signer l'état OAuth.
COOKIE_SECRET=remplacez-moi-par-une-longue-valeur-aleatoire

# V5 — Assistant IA optionnel : "ollama" (local, sans clé) ou "openai".
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Requis uniquement avec AI_PROVIDER=openai. La clé reste exclusivement dans le backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
